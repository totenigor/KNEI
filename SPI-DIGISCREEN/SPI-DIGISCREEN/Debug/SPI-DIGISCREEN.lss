 1da:	f4 e0       	ldi	r31, 0x04	; 4
 1dc:	80 ed       	ldi	r24, 0xD0	; 208
 1de:	81 83       	std	Z+1, r24	; 0x01
	PORTA.OUTSET = PIN7_bm;									//SETTING PA7 TO HIGH STATE SO IT DOESNT START A DATA TRANSMIT INSTANTLY AFTER TURNING ON THE PROGRAM
 1e0:	80 e8       	ldi	r24, 0x80	; 128
 1e2:	85 83       	std	Z+5, r24	; 0x05
	SPI0.CTRLA |= SPI_MASTER_bm;							//SETTING UP SPI HOST MODE
 1e4:	e0 e4       	ldi	r30, 0x40	; 64
 1e6:	f9 e0       	ldi	r31, 0x09	; 9
 1e8:	80 81       	ld	r24, Z
 1ea:	80 62       	ori	r24, 0x20	; 32
 1ec:	80 83       	st	Z, r24
	SPI0.CTRLA |= SPI_PRESC_DIV64_gc;						//SETTING UP THE PRESCALER
 1ee:	80 81       	ld	r24, Z
 1f0:	84 60       	ori	r24, 0x04	; 4
 1f2:	80 83       	st	Z, r24
	SPI0.CTRLA |= SPI_ENABLE_bm;							//ENABLING SPI
